rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.uid == 'Zm6IBgsvXkO9pBRmJlKbJ3YicnA3' ||
        request.auth.token.email == 'dionyyr@gmail.com' &&
        request.auth.token.email_verified == true
      );
    }

    match /users/{userId} {
      allow read: if signedIn() && (isAdmin() || request.auth.uid == userId);
      allow create: if isAdmin() || (
        signedIn() && request.auth.uid == userId && request.resource.data.role == 'user'
      );
      allow update, delete: if isAdmin();
    }

    // Operational records are available only to authenticated Appoli users.
    match /petani/{documentId} {
      allow read, write: if signedIn();
    }

    match /analisaUsaha/{documentId} {
      allow read, write: if signedIn();
    }

    match /inspeksiICS/{documentId} {
      allow read, write: if signedIn();
    }

    match /dataLahan/{documentId} {
      allow read, write: if signedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
